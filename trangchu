<script>
(function(){
var $=function(i){return document.getElementById(i)};
var fmt=function(n,d){return n.toLocaleString('vi-VN',{maximumFractionDigits:d||0})};
/* Hero curve */
var pts=[],i,x,y,t;
for(i=0;i<=40;i++){t=i/40;x=10+380*t;y=130-Math.pow(Math.sin(Math.PI*t),1.6)*105;pts.push([x,y])}
var d='M'+pts.map(function(p){return p[0].toFixed(1)+' '+p[1].toFixed(1)}).join(' L');
$('curve').setAttribute('d',d);$('curveFill').setAttribute('d',d+' L390 130 L10 130Z');
var peak=960,sum=0,tick=0;
function run(){tick+=1;var f=Math.min(tick/60,1);
$('kw').textContent=fmt(peak*f)+' kW';
$('kwh').textContent=fmt(5400*f)+' kWh';
$('co').textContent=fmt(5400*f*0.66/1000,2)+' tấn';
if(f<1)requestAnimationFrame(run)}
if(window.matchMedia('(prefers-reduced-motion:reduce)').matches){tick=60}
run();
/* Calculator */
var st={reg:1150,sh:.8};
function seg(id,key){$(id).addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;
Array.prototype.forEach.call($(id).children,function(c){c.setAttribute('aria-pressed',c===b)});st[key]=parseFloat(b.dataset.v);calc()})}
seg('reg','reg');seg('shift','sh');
['bill','area'].forEach(function(k){$(k).addEventListener('input',calc)});
function calc(){
var bill=+$('bill').value,area=+$('area').value;
$('billV').textContent=bill+' triệu đ';$('areaV').textContent=fmt(area)+' m²';
var price=2000,monthlyKwh=bill*1e6/price,annualLoad=monthlyKwh*12;
var kwpLoad=annualLoad*st.sh/st.reg,kwpRoof=area/6;
var kwp=Math.max(10,Math.min(kwpLoad,kwpRoof));
var gen=kwp*st.reg,used=gen*st.sh>annualLoad?annualLoad:gen*st.sh;
var unit=kwp<500?12:kwp<2000?10.8:9.5;var capex=kwp*unit*1e6;
var cum=0,pay=null,series=[],y1=0;
for(var y=1;y<=25;y++){
var s=used*Math.pow(0.995,y-1)*price*Math.pow(1.03,y-1)-capex*0.01;
if(y==1)y1=s;var prev=cum;cum+=s;
if(pay===null&&prev<capex&&cum>=capex)pay=y-1+(capex-prev)/s;
series.push(cum-capex)}
$('rKwp').textContent=kwp>=1000?fmt(kwp/1000,2)+' MWp':fmt(kwp)+' kWp';
$('rSave').textContent=fmt(y1/1e6)+' triệu đ';
$('rPay').textContent=pay===null?'> 25 năm':fmt(pay,1)+' năm';
$('rGen').textContent=fmt(gen/1000)+' MWh';
$('rCap').textContent=capex>=1e9?fmt(capex/1e9,2)+' tỷ đ':fmt(capex/1e6)+' triệu đ';
$('rCo').textContent=fmt(gen*0.66/1000)+' tấn';
var last=series[24];$('rCum').textContent=(last>=1e9?fmt(last/1e9,2)+' tỷ đ':fmt(last/1e6)+' triệu đ');
var mn=Math.min.apply(null,series.concat([-capex])),mx=Math.max.apply(null,series);
var zero=80-(0-mn)/(mx-mn)*70;
var path=series.map(function(v,k){return (k?'L':'M')+(10+k*15.8).toFixed(1)+' '+(80-(v-mn)/(mx-mn)*70).toFixed(1)}).join(' ');
$('cf').innerHTML='<line x1="10" x2="390" y1="'+zero.toFixed(1)+'" y2="'+zero.toFixed(1)+'" stroke="var(--line)" stroke-dasharray="4 4"/><path d="'+path+'" fill="none" stroke="var(--grn)" stroke-width="3" stroke-linecap="round"/>';
}
calc();
$('f').addEventListener('submit',function(e){e.preventDefault();$('ok').style.display='block';$('f').reset()});
})();
</script>
